@startuml hanabi

enum EndGame{
    CASTLE_COMPLETE,DECK_EMPTY,EXCED_ISSUE_LIMIT
}

enum Event{
    MISSTAKE,GAME_OVER,PLAYER_PLAY
}

enum Color {
RED,GREEN,BLUE,WHITE,YELLOW
}

interface IObserver{
    + update(event: Event) : void
}

interface IObservable{
    + addObserver(obs: IObserver): void
    + notify(event:Event): void
}

interface IPlayer{
    +getAge():int
    +getName():String
}
interface ICard{
    +getFwColor():Color
    +getFwLevel():Integer
}

class Card {
    - fireworkLevel: Integer
    - fireworkColor: Color
    ==
    +Card(fwLevel:Integer, fwColor: Color):Card
    +getFireworkColor():Color
    +getFireworkLevel():Integer
    +equal(card:Card):Bool <<override>>

}


abstract class CardCollection{
    -cards:List<Card>
    #CardCollection()
    #CardCollection(cardList:List<Card>)
    #takeCard(index:int):Card
    #shuffle():void
    +viewCard(index:int):Card
    +putCard():Bool
    +isEmpty():Bool
    +size():int
    {abstract} +isFull():int

}

class Deck{
    
   +Deck(cards:List<Card>)
   +isFull():Bool <<override>>
   +dealCard():Card 
}

class DiscardStack{
    
    +showTopCard():Card
    {abstract} +isFull():int

}

class PlayerHand{

    +isFull():int
    +takeCard():Card

}

class Player{
    
    static ID :int
    
    -playerId:int
    -hand:PlayerHand
    -name:String
    -age:int

    
    +giveCard():bool
    +removeCard():Card
    +inHand(card:Card): bool
    +remainingCards():int

    +Player(edad,nombre)
    +getName():String
    +getId():int
    +getAge():int

    +equal(player:Player): bool
}

class FwCastleCardStack{
    -fwColor:Color
    -isPlayable(card:Card):bool
    -PlayCard(card:Card):void
}

class MisstakeAndClueManager{
    - issues: int
    - availableClues: int

    +MisstakeAndClueManager()
    +addMisstake():Boolean
    +addClue():Boolean
    +useClue():void
    +isAvailableClue():Boolean
    +isAllUnusedClue():Boolean

}

class TurnAndPlayerManager{
    -final maxPlayers int
    -players:List<Player>
    -playerInTurn:Player

    +playerInTurn():Player
    +addPlayer(player: Player): void
    +isAllPlayerConnected(): bool


}

class Table {
    -gameDeck:Deck
    -gameDiscard:DiscardStack
    -players:TurnAndPlayerManager
    -issAndCl:MisstakeAndClueManager
    -fwCastles:List<FwCastleCardStack>
    -observers:IObserver
    
    
    +playCard(player: IPlayer,card: ICard):void
    +useClue(player: IPlayer):void
    +discardCard(player: IPlayer, card: ICard)

    +getPlayerCards(): ICard
    +getMisstakes(): int
    +getDeckSize(): int
    +getRemainingClues():int
    +getFwCastle(color: Color): ICard
   
    +addPlayer(name:String age:int) : IPlayer
    
    
    -gameOver(tipoDeFinal: GameOver)
}

class GameSetUp{


}

'relaciones

Color --* Card

Card ..|> ICard
Card --o CardCollection

Deck --|> CardCollection

DiscardStack --|> CardCollection

PlayerHand --|> CardCollection

GameCardStack --|> CardCollection


Table *-- Deck
Table *-- DiscardStack
Table *-- FwCastleCardStack
Table --> EndGame
Table *-- MisstakeAndClueManager
Table *-- TurnAndPlayerManager
Table ..|> IObservable

TurnAndPlayerManager *-- Player

Player --*PlayerHand
Player ..|> IPlayer

IObservable --> Event
IObserver --> Event

